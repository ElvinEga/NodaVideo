{
  "id": "branded-wipe",
  "name": "Branded Stinger Wipe",
  "category": "Transitions",
  "default_duration_frames": 24,
  "parameters": [
    {
      "name": "brand_name",
      "label": "Brand / Logo Text",
      "description": "Centered title during stinger",
      "param_type": "text",
      "default_value": "NODACON"
    },
    {
      "name": "fill_color",
      "label": "Fill Wipe Color",
      "description": "Background curtain fill color",
      "param_type": "color",
      "default_value": "#0f172a"
    },
    {
      "name": "accent_color",
      "label": "Accent Color",
      "description": "Text highlight color",
      "param_type": "color",
      "default_value": "#38bdf8"
    }
  ],
  "html_template": "<div style=\"position: absolute; inset: 0; background-color: {{fill_color}}; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">\n  <div style=\"font-size: 72px; font-weight: 900; letter-spacing: 0.25em; color: #ffffff; text-transform: uppercase;\">{{brand_name}}</div>\n  <div style=\"width: 64px; height: 4px; background-color: {{accent_color}}; margin-top: 16px; border-radius: 2px;\"></div>\n</div>"
}
