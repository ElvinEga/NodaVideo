{
  "id": "geometric-iris",
  "name": "Geometric Iris Stinger",
  "category": "Transitions",
  "default_duration_frames": 24,
  "parameters": [
    {
      "name": "channel_name",
      "label": "Channel Name",
      "description": "Identifier in the iris center",
      "param_type": "text",
      "default_value": "NODA"
    },
    {
      "name": "iris_color",
      "label": "Iris Color",
      "description": "Geometric circle color",
      "param_type": "color",
      "default_value": "#6366f1"
    }
  ],
  "html_template": "<div style=\"position: absolute; inset: 0; background: #000000; display: flex; align-items: center; justify-content: center; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">\n  <div style=\"width: 360px; height: 360px; border-radius: 50%; background: {{iris_color}}; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 80px {{iris_color}};\">\n    <span style=\"font-size: 56px; font-weight: 900; color: #ffffff; letter-spacing: 0.1em;\">{{channel_name}}</span>\n  </div>\n</div>",
  "svg_template": "<circle cx=\"960\" cy=\"540\" r=\"300\" fill=\"{{iris_color}}\"/><circle cx=\"960\" cy=\"540\" r=\"220\" fill=\"#0f172a\"/><text x=\"960\" y=\"560\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"48\" font-weight=\"900\" letter-spacing=\"8\" fill=\"#ffffff\">{{channel_name}}</text>"
}
