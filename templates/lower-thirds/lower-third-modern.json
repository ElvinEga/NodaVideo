{
  "id": "lower-third-modern",
  "name": "Lower Third (Modern)",
  "category": "Lower Thirds",
  "default_duration_frames": 96,
  "parameters": [
    {
      "name": "title",
      "label": "Speaker Name",
      "description": "Main speaker or subject name",
      "param_type": "text",
      "default_value": "Alex Rivera"
    },
    {
      "name": "subtitle",
      "label": "Title / Role",
      "description": "Speaker designation or organization",
      "param_type": "text",
      "default_value": "Lead Director & Editor"
    },
    {
      "name": "accent_color",
      "label": "Accent Color",
      "description": "Left highlight bar color",
      "param_type": "color",
      "default_value": "#3b82f6"
    }
  ],
  "html_template": "<div style=\"position: absolute; bottom: 80px; left: 80px; display: flex; align-items: stretch; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(12px); border-radius: 8px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">\n  <div style=\"width: 6px; background-color: {{accent_color}};\"></div>\n  <div style=\"padding: 16px 24px;\">\n    <div style=\"font-size: 28px; font-weight: 700; color: #ffffff; letter-spacing: -0.01em; margin-bottom: 4px;\">{{title}}</div>\n    <div style=\"font-size: 16px; font-weight: 500; color: #94a3b8; letter-spacing: 0.05em; text-transform: uppercase;\">{{subtitle}}</div>\n  </div>\n</div>"
}
